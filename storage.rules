rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == "Flm4gI994QbGVus0hAPnzitT3Eb2" ||
        request.auth.uid == "OuYlRbBeHqZYzuALwJ7qyfTYy8j1"
      );
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
